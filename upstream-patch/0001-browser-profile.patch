diff --git a/internal/testutils/filelock_js.go b/internal/testutils/filelock_js.go
new file mode 100644
index 000000000..5aec8c3e4
--- /dev/null
+++ b/internal/testutils/filelock_js.go
@@ -0,0 +1,20 @@
+//go:build js
+
+package testutils
+
+import (
+	"errors"
+	"os"
+)
+
+// errNoFileLocking is what the js/wasm port reports instead of taking a lock.
+//
+// The helper exists to prove cross-process lock behavior, and js/wasm has no
+// second process to prove it against. Succeeding silently would let a caller
+// believe it held a lock it does not hold, so both halves refuse; the helper's
+// callers are tests that do not run on this platform.
+var errNoFileLocking = errors.New("testutils: file locking is not available on js")
+
+func lockFile(*os.File) error { return errNoFileLocking }
+
+func unlockFile(*os.File) error { return errNoFileLocking }
