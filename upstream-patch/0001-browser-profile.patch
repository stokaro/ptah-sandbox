diff --git a/internal/devlock/identity_js.go b/internal/devlock/identity_js.go
new file mode 100644
index 000000000..fe7b224e6
--- /dev/null
+++ b/internal/devlock/identity_js.go
@@ -0,0 +1,23 @@
+//go:build js
+
+package devlock
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// filesystemIdentity falls back to the cleaned absolute path, because
+// syscall.Stat_t carries no device or inode number on js. Two names for one
+// file therefore look like two realms; on a filesystem with one writer that
+// costs nothing.
+func filesystemIdentity(path string) (string, error) {
+	if _, err := os.Stat(path); err != nil {
+		return "", err
+	}
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	return filepath.Clean(abs), nil
+}
