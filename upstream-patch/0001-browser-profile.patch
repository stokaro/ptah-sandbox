+
+import (
+	"context"
+	"database/sql"
+
+	"ptah.run/internal/browsersqlite"
+)
+
+// applyAttachedDatabaseLimit hands the limit to whichever engine the host
+// installed, because on js/wasm there is no modernc.org/sqlite to ask.
