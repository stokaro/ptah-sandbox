new file mode 100644
index 000000000..53e30b743
--- /dev/null
+++ b/internal/dbschema/sqlite/restrict_notjs.go
@@ -0,0 +1,19 @@
+//go:build !js
+
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+
+	sqlitedriver "modernc.org/sqlite"
+	sqlite3 "modernc.org/sqlite/lib"
+)
+
+// applyAttachedDatabaseLimit sets SQLITE_LIMIT_ATTACHED to 0 on the pinned
+// session. The driver reaches the C limit directly, so the context is not
+// consulted here; RestrictSession still verifies the result.
+func applyAttachedDatabaseLimit(_ context.Context, session *sql.Conn) error {
+	_, err := sqlitedriver.Limit(session, sqlite3.SQLITE_LIMIT_ATTACHED, 0)
+	return err
+}
