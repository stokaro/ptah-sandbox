index 000000000..f49d0cecf
--- /dev/null
+++ b/internal/dbschema/oracle/oracleerror_notjs.go
@@ -0,0 +1,19 @@
+//go:build !js
+
+package oracle
+
+import (
+	"errors"
+
+	"github.com/sijms/go-ora/v3/network"
+)
+
+// oracleErrorCode reports the ORA- number the server sent, if the failure came
+// from the Oracle driver at all.
+func oracleErrorCode(err error) (int, bool) {
+	var oracleErr *network.OracleError
+	if !errors.As(err, &oracleErr) {
+		return 0, false
+	}
+	return oracleErr.ErrCode, true
+}
