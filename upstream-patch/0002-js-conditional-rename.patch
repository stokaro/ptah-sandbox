Subject: [PATCH] fsdurable: a conditional rename for js/wasm

internal/fsdurable publishes an artifact by renaming it into place with a
flag that refuses to replace an unexpected destination (RENAME_NOREPLACE
on linux, RENAME_EXCL on darwin) or by exchanging it with one
(RENAME_EXCHANGE / RENAME_SWAP). js/wasm has neither syscall, and no
renameat(2) to carry the flags, so it falls into publication_unix_other.go
and every publication fails closed:

  ptah migrations generate --schema-file schema.sql --db-url sqlite://app.db \
    --migrations-dir migrations --name init
  error: error creating migration files: finalize artifact publication:
  retire migration publication journal: conditional publication is
  unsupported here: .migrations.ptah-migrate-diff.pending.cleanup: the
  filesystem rejected the conditional rename primitive: ...

The command exits 2 where it exits 0 natively, and leaves its journal
files (.migrations.ptah-migrate-diff.{lock,pending,pending.*.tmp,
pending.committed}) beside the migration it did in fact write.

The flags exist to close the window between deciding what the
destination holds and replacing it. On js/wasm there is no window: a wasm
instance is one scheduler over a filesystem no other process can reach,
so an lstat and the rename that follows it cannot be separated by anyone.
The primitives are therefore composed from ordinary renames on this
platform and keep the guarantee they are there to give. This is the same
argument internal/devlock and internal/atlasmigrate make for their js
locks, and it stops being true the moment two instances share one
filesystem, which is why it is confined to //go:build js.

classifyConditionalRename and isUnsupportedRenameError move to their own
!windows file unchanged, because MoveDirNoReplace still needs them on a
platform that no longer builds publication_unix.go.

diff --git a/internal/fsdurable/conditional_rename_nonwindows.go b/internal/fsdurable/conditional_rename_nonwindows.go
new file mode 100644
index 0000000..91d0bd4
--- /dev/null
+++ b/internal/fsdurable/conditional_rename_nonwindows.go
@@ -0,0 +1,36 @@
+//go:build !windows
+
+package fsdurable
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+// classifyConditionalRename separates "the caller lost the race" from "this
+// filesystem cannot do conditional renames at all". The second case must fail
+// closed: silently retrying with rename(2) would restore the unconditional
+// replacement this package exists to prevent, and the developer filesystems
+// that do support the flags would never show it.
+func classifyConditionalRename(op, oldName, newName string, err error) error {
+	if err == nil {
+		return nil
+	}
+	if isUnsupportedRenameError(err) {
+		return unsupportedPublicationError(newName, &os.LinkError{
+			Op:  op,
+			Old: oldName,
+			New: newName,
+			Err: err,
+		})
+	}
+	return &os.LinkError{Op: op, Old: oldName, New: newName, Err: err}
+}
+
+func isUnsupportedRenameError(err error) bool {
+	return errors.Is(err, syscall.EINVAL) ||
+		errors.Is(err, syscall.ENOSYS) ||
+		errors.Is(err, syscall.EOPNOTSUPP) ||
+		errors.Is(err, errConditionalRenameUnavailable)
+}
diff --git a/internal/fsdurable/publication_js.go b/internal/fsdurable/publication_js.go
new file mode 100644
index 0000000..f7a23ba
--- /dev/null
+++ b/internal/fsdurable/publication_js.go
@@ -0,0 +1,65 @@
+//go:build js
+
+package fsdurable
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"math/rand/v2"
+	"os"
+	"syscall"
+)
+
+// js/wasm has no renameat(2) and therefore neither of the flags the rest of
+// this package publishes with. What it does have instead is the reason those
+// flags exist: a wasm instance is a single scheduler over a filesystem no
+// other process can reach, so nothing can change an entry between the check
+// and the rename. The conditional renames are composed from ordinary
+// operations here, and the guarantee they are supposed to give -- never
+// replace a destination the caller did not expect -- still holds.
+//
+// This is the same argument internal/devlock and internal/atlasmigrate make
+// for their js locks. It stops being true the moment two instances share one
+// filesystem, which is why it is confined to this platform.
+
+func rootRenameNoReplace(root *os.Root, oldName, newName string) error {
+	if _, err := root.Lstat(newName); err == nil {
+		return &os.LinkError{Op: "renameat-noreplace", Old: oldName, New: newName, Err: syscall.EEXIST}
+	} else if !errors.Is(err, fs.ErrNotExist) {
+		return classifyConditionalRename("renameat-noreplace", oldName, newName, err)
+	}
+	return classifyConditionalRename("renameat-noreplace", oldName, newName,
+		root.Rename(oldName, newName))
+}
+
+// rootRenameExchange swaps the two entries: after it returns, newName holds
+// what oldName held and oldName holds what newName held. Three renames through
+// a scratch name, which is atomic enough on a filesystem with one user; a
+// failure part-way leaves the scratch name behind rather than either entry
+// silently gone, and says where it is.
+func rootRenameExchange(root *os.Root, oldName, newName string) error {
+	const op = "renameat-exchange"
+	if _, err := root.Lstat(newName); err != nil {
+		return classifyConditionalRename(op, oldName, newName, err)
+	}
+	scratch := fmt.Sprintf("%s.ptah-exchange-%08x", newName, rand.Uint32())
+	if err := rootRenameNoReplace(root, newName, scratch); err != nil {
+		return classifyConditionalRename(op, oldName, newName, err)
+	}
+	if err := root.Rename(oldName, newName); err != nil {
+		// Put the destination back before reporting, so a failed exchange
+		// leaves the tree as it was found.
+		return classifyConditionalRename(op, oldName, newName,
+			errors.Join(err, root.Rename(scratch, newName)))
+	}
+	if err := root.Rename(scratch, oldName); err != nil {
+		return &os.LinkError{
+			Op:  op,
+			Old: oldName,
+			New: newName,
+			Err: fmt.Errorf("the displaced destination is preserved at %s: %w", scratch, err),
+		}
+	}
+	return nil
+}
